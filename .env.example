PORT=3200

# ─── LLM defaults (first-boot seed only) ──────────────────────────────────────
# These seed the provider registry on first run. After that, providers, models,
# endpoints, and API keys are managed at runtime via the Settings UI (⚙️) and
# persisted to data/llm-config.json — no redeploy needed to change models.
DEFAULT_LLM_PROVIDER=ollama
DEFAULT_LLM_MODEL=gemma3:12b
OLLAMA_HOST=http://localhost:11434
GEMINI_API_KEY=
OPENAI_API_KEY=

# ─── Persistence ──────────────────────────────────────────────────────────────
# Where the runtime provider registry is stored. Defaults to ./data/llm-config.json.
# Point this at a mounted volume in containers so settings survive restarts.
# LLM_CONFIG_PATH=./data/llm-config.json
